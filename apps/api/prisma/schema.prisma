generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  REJECTED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum SupplierInvoiceStatus {
  DRAFT
  PENDING_MATCHING
  APPROVED
  PAID
  REJECTED
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum StockTransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum MovementReason {
  PURCHASE_RECEIPT
  PURCHASE_CANCELLATION_RETURN
  SALE
  ADJUSTMENT
  RETURN
}

enum ApprovableEntity {
  PURCHASE_ORDER
  PURCHASE_ORDER_CANCELLATION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products             Product[]
  warehouses           Warehouse[]
  suppliers            Supplier[]
  customers            Customer[]
  purchaseOrders       PurchaseOrder[]
  salesOrders          SalesOrder[]
  inventoryItems       InventoryItem[]
  inventoryMovements   InventoryMovement[]
  stockTransfers       StockTransfer[]
  generalLedgerEntries GeneralLedgerEntry[]
  supplierInvoices     SupplierInvoice[]
  invoices             Invoice[]
  users                User[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  roles        String[]
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Customer {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  email       String       @default("")
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesOrders SalesOrder[]
}

model Supplier {
  id               String            @id @default(uuid())
  tenantId         String
  name             String
  email            String?           @default("")
  phone            String?           @default("")
  address          String?           @default("")
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders   PurchaseOrder[]
  supplierInvoices SupplierInvoice[]
}

model Warehouse {
  id              String          @id @default(uuid())
  tenantId        String
  name            String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItems  InventoryItem[]
  purchaseOrders  PurchaseOrder[]
  salesOrders     SalesOrder[]
  sourceTransfers StockTransfer[] @relation("SourceWarehouse")
  destTransfers   StockTransfer[] @relation("DestWarehouse")
}

model Product {
  id                   String                @id @default(uuid())
  tenantId             String
  sku                  String                @unique
  name                 String
  unitCost             Decimal               @default(0.0) @db.Decimal(12, 2)
  unitPrice            Decimal               @default(0.0) @db.Decimal(12, 2)
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItems       InventoryItem[]
  purchaseOrderLines   PurchaseOrderLine[]
  salesOrderLines      SalesOrderLine[]
  stockTransfers       StockTransfer[]
  supplierInvoiceLines SupplierInvoiceLine[]
}

model InventoryItem {
  reorderLevel Int @default(10)
  id             String              @id @default(uuid())
  tenantId       String
  productId      String
  warehouseId    String
  quantityOnHand Int                 @default(0)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  movements      InventoryMovement[]

  @@unique([productId, warehouseId])
}

model InventoryMovement {
  id              String         @id @default(uuid())
  tenantId        String
  inventoryItemId String
  quantityChange  Int
  reason          MovementReason
  referenceId     String?
  createdAt       DateTime       @default(now())
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  tenantId         String
  supplierId       String
  warehouseId      String?
  createdById      String?
  status           PurchaseOrderStatus @default(DRAFT)
  orderedAt        DateTime?
  receivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  warehouse        Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  lines            PurchaseOrderLine[]
  supplierInvoices SupplierInvoice[]
}

model PurchaseOrderLine {
  id                   String                @id @default(uuid())
  purchaseOrderId      String
  productId            String
  quantityOrdered      Int                   @default(0)
  quantityReceived     Int                   @default(0)
  unitCost             Decimal               @default(0.0) @db.Decimal(12, 2)
  purchaseOrder        PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierInvoiceLines SupplierInvoiceLine[]
}

model SalesOrder {
  id          String           @id @default(uuid())
  tenantId    String
  customerId  String
  warehouseId String
  status      SalesOrderStatus @default(DRAFT)
  createdAt   DateTime         @default(now())
  fulfilledAt DateTime?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  lines       SalesOrderLine[]
  invoices    Invoice[]
}

model SalesOrderLine {
  id           String     @id @default(uuid())
  salesOrderId String
  productId    String
  quantity     Int
  unitPrice    Decimal    @db.Decimal(12, 2)
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model StockTransfer {
  id                String              @id @default(uuid())
  tenantId          String
  productId         String
  sourceWarehouseId String
  destWarehouseId   String
  quantity          Int
  status            StockTransferStatus @default(PENDING)
  createdAt         DateTime            @default(now())
  completedAt       DateTime?
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceWarehouse   Warehouse           @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Cascade)
  destWarehouse     Warehouse           @relation("DestWarehouse", fields: [destWarehouseId], references: [id], onDelete: Cascade)
}

model ApprovalRequest {
  id                   String           @id @default(uuid())
  tenantId             String
  entityType           ApprovableEntity
  entityId             String
  status               ApprovalStatus   @default(PENDING)
  reason               String?
  requestedById        String
  approverRoleRequired String
  decidedById          String?
  decidedAt            DateTime?
  decisionNote         String?
  createdAt            DateTime         @default(now())

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([status])
}

model SupplierInvoice {
  id              String                @id @default(uuid())
  tenantId        String
  supplierId      String
  purchaseOrderId String
  invoiceNumber   String
  subTotal        Decimal               @db.Decimal(12, 2)
  taxTotal        Decimal               @db.Decimal(12, 2)
  grandTotal      Decimal               @db.Decimal(12, 2)
  dueDate         DateTime
  status          SupplierInvoiceStatus @default(PENDING_MATCHING)
  createdAt       DateTime              @default(now())
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier        Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lines           SupplierInvoiceLine[]
}

model SupplierInvoiceLine {
  id                  String            @id @default(uuid())
  supplierInvoiceId   String
  purchaseOrderLineId String
  productId           String
  quantity            Int
  unitPrice           Decimal           @db.Decimal(12, 2)
  total               Decimal           @db.Decimal(12, 2)
  supplierInvoice     SupplierInvoice   @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  product             Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String
  salesOrderId  String
  invoiceNumber String
  totalAmount   Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(UNPAID)
  createdAt     DateTime      @default(now())
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesOrder    SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
}

model GeneralLedgerEntry {
  id          String              @id @default(uuid())
  tenantId    String
  description String
  reference   String?
  status      JournalEntryStatus  @default(POSTED)
  createdAt   DateTime            @default(now())
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines       GeneralLedgerLine[]
}

model GeneralLedgerLine {
  id                   String             @id @default(uuid())
  generalLedgerEntryId String
  accountCode          String
  debit                Decimal            @default(0.0) @db.Decimal(12, 2)
  credit               Decimal            @default(0.0) @db.Decimal(12, 2)
  generalLedgerEntry   GeneralLedgerEntry @relation(fields: [generalLedgerEntryId], references: [id], onDelete: Cascade)
}


enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Employee {
  status String? @default("ACTIVE")
  grossSalary Float?
  salary Float?
  payrolls PayrollRecord[]
  paySlips PaySlip[]
  employmentType EmploymentType? @default(FULL_TIME)
  position String?
  id            String         @id @default(uuid())
  tenantId      String
  firstName     String
  lastName      String
  email         String
  department String?
  jobTitle String?
  leaveBalance  Float          @default(21)
  leaveRequests LeaveRequest[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}



model AuditLog {
  userAgent String?
  ipAddress String?
  details Json?
  entityId   String?
  afterData  Json?
  beforeData Json?
  actorId   String?
  userEmail String?
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  payload Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

// Update or extend HR models with complete leave fields


model LeaveRequest {
  reason String?
  id            String      @id @default(uuid())
  tenantId      String
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id])
  leaveType String?
  startDate     DateTime
  endDate       DateTime
  daysRequested Int?
  status        LeaveStatus @default(PENDING)
  approvedById  String?
  processedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt DateTime?    @updatedAt

  @@index([tenantId])
  @@index([employeeId])
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXECUTE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
  LOW_STOCK
  SYSTEM
}

model PayrollRecord {
  status String? @default("PROCESSED")
  netPay Float?
  deductions Float?
  grossPay Float?
  payPeriod String?
  id          String   @id @default(uuid())
  tenantId    String
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  period String?
  grossAmount Float?
  netAmount Float?
  taxAmount Float?
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model PaySlip {
  uifEmployer Float?
  uifEmployee Float?
  tax Float?
  id           String   @id @default(uuid())
  tenantId     String
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  period       String
  grossSalary Float?
  netSalary Float?
  payeTax Float?
  uifDeduction Float?
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  title     String
  message   String
  type      String?  @default("INFO")
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
}
